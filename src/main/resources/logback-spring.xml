<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Custom converter: chỉ hiển thị frame com.ait.* và root cause -->
    <conversionRule conversionWord="cex" class="com.ait.config.CompactExceptionConverter"/>

    <!-- Charset console: mặc định UTF-8 (cửa sổ cmd phải ở code page 65001 - chcp 65001).
         Đổi bằng property logging.charset.console hoặc biến môi trường LOGGING_CHARSET_CONSOLE nếu cần. -->
    <springProperty scope="context" name="consoleCharset" source="logging.charset.console" defaultValue="UTF-8"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>${consoleCharset}</charset>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%logger{30}] %msg%n%cex</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/hr-application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/hr-application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%logger{30}] %msg%n%cex</pattern>
        </encoder>
    </appender>

    <!-- Ghi log BẤT ĐỒNG BỘ: thread xử lý request chỉ đẩy log vào hàng đợi rồi chạy tiếp.
         Lý do: cửa sổ console Windows (Tomcat startup.bat) ghi rất chậm, và khi người dùng click/bôi đen
         vào cửa sổ (QuickEdit mode) thì việc ghi console bị TẠM DỪNG -> mọi thread đang log bị treo,
         giữ connection DB -> pool cạn -> toàn bộ ứng dụng đứng.
         neverBlock=true: hàng đợi đầy thì bỏ bớt log console chứ không chặn thread. -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>4096</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- Dev profile: DEBUG cho com.ait -->
    <springProfile name="dev">
        <logger name="com.ait" level="DEBUG" additivity="false">
            <appender-ref ref="ASYNC_CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </logger>
    </springProfile>

    <!-- Mặc định (prod/không có profile): WARN -->
    <springProfile name="!dev">
        <logger name="com.ait" level="WARN" additivity="false">
            <appender-ref ref="ASYNC_CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </logger>
    </springProfile>

    <!-- Framework loggers: giảm noise -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="oracle.jdbc" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </root>

</configuration>
